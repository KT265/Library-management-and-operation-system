# ==============================================================================
# PAYOS PAYMENT GATEWAY CREDENTIALS (Backend)
# ==============================================================================
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# ==============================================================================
# FIREBASE WEB CLIENT CONFIGURATION (Frontend Vite)
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# ==============================================================================
# FIREBASE ADMIN SDK (Backend Service Account)
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
